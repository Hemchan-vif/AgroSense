# Application
NODE_ENV=development
DEMO_MODE=true
PORT=3000

# Database (local by default; docker-compose overrides to mongodb service)
MONGODB_URI=mongodb://localhost:27017/agrosense

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# Public URLs / AI service
FRONTEND_URL=http://localhost:4200
AI_SERVICE_URL=http://localhost:8000
CROP_MODEL_ENABLED=false
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_FALLBACK_MODEL=gemini-3.5-flash
AI_LAST_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional Cloudflare tunnel for local Telegram Mini App development
AUTO_TUNNEL=false
